{
  "name": "@seeu/case-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SeeUForensicsAgentPlus 案件索引：在 Harness Web UI 里建库并手工检索火眼全解析结果",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "tools/ges-index/*.mjs"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
